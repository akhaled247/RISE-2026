<?xml version="1.0" encoding="utf-8"?>
<launch>

  <!-- We resume the logic in empty_world.launch, changing the name of the world to be launched -->
  <include file="$(find sawyer_gazebo)/launch/sawyer_world.launch">
    <arg name="electric_gripper" value="true"/>
  </include>

  <!-- Spawn table SDF -->
  <node name="spawn_cafe_table"
        pkg="gazebo_ros"
        type="spawn_model"
        args="-file $(find sawyer_sim_examples)/models/cafe_table/model.sdf
              -sdf
              -model cafe_table
              -x 0.75
              -y 0.0
              -z 0.0
              -Y 0.0" />

  <!-- Spawn block URDF -->
  <node name="spawn_red_block_1"
        pkg="gazebo_ros"
        type="spawn_model"
        args="-file $(find sawyer_sim_examples)/models/red_block/model.urdf
              -urdf
              -model red_block_1
              -x 0.7
              -y 0
              -z 0.7725
              " />

  <node name="spawn_blue_block_1"
        pkg="gazebo_ros"
        type="spawn_model"
        args="-file $(find sawyer_sim_examples)/models/blue_block/model.urdf
              -urdf
              -model blue_block_1
              -x 0.5
              -y 0
              -z 0.7725
              " />

  <node name="spawn_banana"
        pkg="gazebo_ros"
        type="spawn_model"
        args="-file $(find sawyer_sim_examples)/models/plastic_banana/model.urdf
              -urdf
              -model banana
              -x 0.6
              -y -0.2
              -z 0.7935
              " />

  <node name="spawn_white_mug"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-file $(find sawyer_sim_examples)/models/white_mug/model.sdf
              -sdf
              -model white_mug
              -x 0.6
              -y 0.2
              -z 0.775
              " />

  <node name="spawn_plate"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-file $(find sawyer_sim_examples)/models/plate/model.sdf
              -sdf
              -model plate
              -x 0.85
              -y -0.18
              -z 0.775
              " />

  <include file="$(find object_tf)/launch/object_tf.launch" />

  <include file="$(find vlm)/launch/vlm.launch" />

  <!-- Start the Sawyer pick and place demo -->
  <node pkg="sawyer_sim_examples" type="ik_pick_and_place_demo.py" name="ik_pick_and_place_demo" output="screen" />
</launch>
