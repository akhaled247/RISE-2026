<?xml version="1.0" encoding="utf-8"?>
<launch>

  <!-- We resume the logic in empty_world.launch, changing the name of the world to be launched -->
  <include file="$(find sawyer_gazebo)/launch/sawyer_world.launch">
    <arg name="electric_gripper" value="true"/>
  </include>

  <!-- Spawn table SDF -->
  <node name="spawn_cafe_table"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-file $(find sawyer_sim_examples)/models/cafe_table/model.sdf
              -sdf
              -model cafe_table
              -x 0.75
              -y 0.0
              -z 0.0
              -Y 0.0" />

  <!-- Spawn block URDF -->
  <node name="spawn_block"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-file $(find sawyer_sim_examples)/models/block/model.urdf
              -urdf
              -model block
              -x 0.7
              -y 0
              -z 0.7725
              -Y 0.0" />

  <include file="$(find object_tf)/launch/object_tf.launch" />


  <!-- Start the Sawyer pick and place demo -->
  <node pkg="sawyer_sim_examples" type="ik_pick_and_place_demo.py" name="ik_pick_and_place_demo" />
</launch>
